# LogPulse — environment variable reference
#
# Copy this file to .env for local development.
# Never commit .env — it is gitignored.
#
# All variables have built-in defaults, so .env is optional locally.

# Runtime environment
# Allowed: development | test | production
NODE_ENV=development

# Fastify listen address and port
HOST=0.0.0.0
PORT=8080

# Pino log level
# Allowed: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://logija:logija@localhost:5432/logija
